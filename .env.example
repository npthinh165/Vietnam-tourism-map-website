# Copy to .env. PostgreSQL 15+; Supabase PostgreSQL is also supported.
# Use the server database connection string, never expose it through VITE_*.
# For local development without PostgreSQL, leave DATABASE_URL unset and run npm run dev.
# That command stores a PGlite database in .runtime/postgres; python -m backend serve / npm start never use it.
DATABASE_URL="postgresql://travel:change-me@localhost:5432/vntravel?schema=public"

# Exact browser origin. Development Vite proxies /api to localhost:3002.
APP_URL="http://localhost:3000"
PORT=3002
HOST="127.0.0.1"
NODE_ENV="development"

# Set to the exact number of trusted reverse proxies in production, usually 1.
# Keep 0 when Python is directly reachable. Production APP_URL must use HTTPS.
TRUST_PROXY_HOPS=0

# Optional inputs for npm run admin:create. Never use VITE_ for these values.
# ADMIN_EMAIL="admin@maptravel.com"
# ADMIN_NAME="Quản trị viên"
# ADMIN_PASSWORD="ABCadmin!maptravel"
