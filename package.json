{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node tools/python.mjs -m backend dev",
    "dev:api": "node tools/python.mjs -m backend dev --api-only",
    "dev:web": "vite --port=3000 --host=0.0.0.0 --strictPort",
    "admin:create": "node tools/python.mjs -m backend create-admin",
    "build": "vite build",
    "build:geojson": "tsx tools/build-geojson.js",
    "preview": "vite preview",
    "preview:api": "node tools/python.mjs -m backend preview",
    "api": "node tools/python.mjs -m backend serve",
    "start": "node tools/python.mjs -m backend serve",
    "test": "npm run test:python && npm run test:contract",
    "test:python": "node tools/python.mjs -m pytest",
    "test:contract": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit && node tools/python.mjs -m ruff check backend tests_python tools/python-test-server.py && node tools/python.mjs -m ruff format --check backend tests_python tools/python-test-server.py && npm run catalog:check",
    "catalog:export": "tsx tools/export-python-catalog.ts",
    "catalog:check": "tsx tools/export-python-catalog.ts --check",
    "db:generate": "prisma generate",
    "db:deploy": "node tools/python.mjs -m backend migrate",
    "db:seed": "node tools/python.mjs -m backend seed"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "@turf/turf": "^7.4.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "bcrypt": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
